# GEMINI_API_KEY: Required for Gemini AI API calls (backend).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Alternative AI provider key (backend).
GROQ_API_KEY="MY_GROQ_API_KEY"

# Google Maps API Key (frontend)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_KEY"

# VITE_API_BASE_URL: URL of the deployed Railway backend.
# Leave empty for local dev (Vite proxy handles /api → localhost:3000).
# Set to your Railway URL in production, e.g.: https://civicpulse-backend.railway.app
VITE_API_BASE_URL=""

# Firebase project ID (used by backend Firebase Admin SDK on Railway)
FIREBASE_PROJECT_ID="civicpulse-app-9bdfd"